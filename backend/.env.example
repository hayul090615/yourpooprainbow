# PostgreSQL connection settings for local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geuphaeyo
DB_USER=postgres
DB_PASSWORD=change_this_password

# Set to true only when the database requires SSL.
DB_SSL=false

# 운영에서는 위 개별 DB_* 값 대신 연결 문자열을 사용할 수 있습니다.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Kakao Developers 앱의 REST API 키입니다. JavaScript 키가 아닙니다.
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Google Web OAuth Client ID입니다. Client Secret은 사용하지 않습니다.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Google 로그인 시 관리자 역할을 부여할 이메일 목록입니다.
ADMIN_EMAILS=admin@example.com

# `npm run admin:create` 실행 시에만 사용할 관리자 계정 값입니다.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_at_least_12_characters
ADMIN_NAME=관리자

# 쉼표로 구분한 프론트엔드 허용 주소입니다.
FRONTEND_ORIGINS=http://localhost:5173,https://yourpooprainbow.vercel.app
